@{
    ViewData["Title"] = "WSDL & XSD Viewer";
}

<div class="viewer-shell">
    <div class="viewer-header">
        <h1>WSDL &amp; XSD Viewer</h1>
        <p>Paste a URL or drop a file from your desktop to explore operations and schema models.</p>
    </div>

    <div class="viewer-grid">
        <section class="viewer-card">
            <h2>WSDL</h2>

            <form id="wsdl-form" method="post" enctype="multipart/form-data" action="/renderWsdl">
                <div class="mb-3">
                    <label for="wsdl_uri" class="form-label" data-bs-toggle="tooltip" title="Clear the WSDL file selection to edit the URL.">WSDL URL</label>
                    <div class="input-with-clear">
                        <input id="wsdl_uri" name="uri" class="form-control" placeholder="https://example.com/service.wsdl" />
                        <button type="button" class="clear-input-btn" aria-label="Clear WSDL URL" data-target-input="wsdl_uri">&times;</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="wsdl_file" class="form-label" data-bs-toggle="tooltip" title="Clear the WSDL URL to enable file upload.">Or choose a local WSDL file</label>
                    <div class="input-with-clear">
                        <input id="wsdl_file" name="wsdlFile" type="file" accept=".wsdl,.xml,.xsd" class="form-control" />
                        <button type="button" class="clear-input-btn" aria-label="Clear WSDL file" data-target-input="wsdl_file">&times;</button>
                    </div>
                </div>

                <div id="wsdl-dropzone" class="dropzone" data-target-input="wsdl_file" data-bs-toggle="tooltip" title="Clear the WSDL URL to enable file upload.">
                    <span class="dropzone-title">Drag &amp; drop WSDL file here</span>
                    <span class="dropzone-subtitle">We never upload anything beyond this browser session.</span>
                </div>

                <div class="viewer-actions">
                    <button type="submit" class="btn btn-primary">View WSDL</button>
                </div>
            </form>
        </section>

        <section class="viewer-card">
            <h2>XSD</h2>

            <form id="xsd-form" method="post" enctype="multipart/form-data" action="/renderXsd">
                <div class="mb-3">
                    <label for="xsd_uri" class="form-label" data-bs-toggle="tooltip" title="Clear the XSD file selection to edit the URL.">XSD URL</label>
                    <div class="input-with-clear">
                        <input id="xsd_uri" name="uri" class="form-control" placeholder="https://example.com/schema.xsd" />
                        <button type="button" class="clear-input-btn" aria-label="Clear XSD URL" data-target-input="xsd_uri">&times;</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="xsd_file" class="form-label">Or choose a local XSD file</label>
                    <div class="input-with-clear">
                        <input id="xsd_file" name="xsdFile" type="file" accept=".xsd,.xml,.wsdl" class="form-control" />
                        <button type="button" class="clear-input-btn" aria-label="Clear XSD file" data-target-input="xsd_file">&times;</button>
                    </div>
                </div>

                <div id="xsd-dropzone" class="dropzone" data-target-input="xsd_file">
                    <span class="dropzone-title">Drag &amp; drop XSD file here</span>
                    <span class="dropzone-subtitle">Remote and relative imports are resolved for you.</span>
                </div>

                <div class="viewer-actions">
                    <button type="submit" class="btn btn-outline-primary">View XSD</button>
                </div>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}